# Environment Configuration for Production Optimization

# ============================================================================
# Database Configuration (Supabase)
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ============================================================================
# Face Recognition Optimization Settings
# ============================================================================

# Enable/disable DeepFace (TensorFlow-based model)
# - false: Use face_recognition only (fast, 77.6% accuracy, 0.09s)
# - true:  Enable hybrid mode (slower, 85%+ accuracy, 0.5s average)
# 
# Production recommendation: false (saves ~700 MB memory + 5s startup)
# Staging/high-accuracy: true
ENABLE_DEEPFACE=false

# Hybrid recognition mode (only applies if ENABLE_DEEPFACE=true)
# - fallback:     Use DeepFace only if face_recognition fails (fastest)
# - smart:        Use DeepFace validation based on confidence (balanced)
# - always_both:  Always run both models and compare (slowest, most accurate)
#
# Production recommendation: fallback
HYBRID_MODE=fallback

# Confidence thresholds for SMART mode (0-100 scale)
# Above HIGH_CONFIDENCE: Accept face_recognition result immediately
# Below LOW_CONFIDENCE:  Prioritize DeepFace result
# Between both:          Validate with DeepFace
HIGH_CONFIDENCE_THRESHOLD=55.0
LOW_CONFIDENCE_THRESHOLD=35.0

# ============================================================================
# Application Settings
# ============================================================================
APP_NAME="Chamada Facial API"
APP_VERSION="1.0.0"
SIMILARITY_THRESHOLD=0.6

# Logging level
# - ERROR:   Production (minimal logs)
# - INFO:    Staging (moderate logs)
# - DEBUG:   Development (verbose logs)
LOG_LEVEL=INFO

# ============================================================================
# Optional: Caching (Phase 4 optimization)
# ============================================================================
# REDIS_URL=redis://localhost:6379
# CACHE_TTL=3600

# ============================================================================
# Optional: Monitoring
# ============================================================================
# SENTRY_DSN=https://your-sentry-dsn
# ENVIRONMENT=production

# ============================================================================
# Usage Examples
# ============================================================================

# Example 1: Fast production mode (face_recognition only)
# ENABLE_DEEPFACE=false
# Expected: 77.6% accuracy, 0.09s per recognition, ~800 MB RAM

# Example 2: High-accuracy staging mode (hybrid with smart validation)
# ENABLE_DEEPFACE=true
# HYBRID_MODE=smart
# Expected: 85%+ accuracy, 0.3-0.8s per recognition, ~1.5 GB RAM

# Example 3: Maximum accuracy testing mode (always use both)
# ENABLE_DEEPFACE=true
# HYBRID_MODE=always_both
# Expected: 90%+ accuracy, 1.0-2.0s per recognition, ~2 GB RAM

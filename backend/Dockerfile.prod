# Multi-stage Docker build for optimized production deployment
# Final image size: ~800 MB-1 GB (vs 2.5 GB before optimization)
# Startup time: 2-3s (vs 8-15s before optimization)

# ============================================================================
# Stage 1: Builder - Install dependencies with build tools
# ============================================================================
FROM python:3.11-slim as builder

WORKDIR /build

# Install system dependencies needed for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libopenblas-dev \
    liblapack-dev \
    libjpeg-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python packages
COPY requirements-prod.txt .
RUN pip install --no-cache-dir --user -r requirements-prod.txt

# ============================================================================
# Stage 2: Production runtime - Minimal image without build tools
# ============================================================================
FROM python:3.11-slim

WORKDIR /app

# Install ONLY runtime libraries (not build tools)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libopenblas0 \
    liblapack3 \
    libjpeg62-turbo \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy installed packages from builder stage
COPY --from=builder /root/.local /root/.local
ENV PATH=/root/.local/bin:$PATH

# Create non-root user for security
RUN useradd -m -u 1000 appuser && chown -R appuser /app
USER appuser

# Copy application code (respects .dockerignore to exclude dev files)
COPY --chown=appuser:appuser app ./app

# Environment variables (production defaults)
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV ENABLE_DEEPFACE=false
ENV HYBRID_MODE=fallback
ENV HIGH_CONFIDENCE_THRESHOLD=55.0
ENV LOW_CONFIDENCE_THRESHOLD=35.0

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/').read()" || exit 1

# Expose port
EXPOSE 8000

# Run application
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
